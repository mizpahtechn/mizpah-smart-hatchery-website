{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "mizpah-website-forms",
  "main": "./server/contact-worker.js",
  "compatibility_date": "2026-11-01",
  "upload_source_maps": true,
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "FROM_EMAIL": "Mizpah Technology <website@mizpahtechnology.com.ng>",
    "ADMIN_EMAIL": "info@mizpahtechnology.com.ng",
    "SUPABASE_URL": "https://ouebgmhtyekqnyrkfrcp.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_4PQqWYUXAi_ECtiSv063NA_G5G7IKDk"
  },
  "secrets": {
    "required": ["RESEND_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "ENQUIRY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
